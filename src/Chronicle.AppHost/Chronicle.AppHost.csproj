<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Readable rather than a GUID: this is the folder name secrets are stored under. -->
    <UserSecretsId>chronicle-apphost</UserSecretsId>
    <!-- AppHost is dev-time orchestration only; never published. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chronicle.Portfolio\Chronicle.Portfolio.Server\Chronicle.Portfolio.Server.csproj" />
  </ItemGroup>

</Project>

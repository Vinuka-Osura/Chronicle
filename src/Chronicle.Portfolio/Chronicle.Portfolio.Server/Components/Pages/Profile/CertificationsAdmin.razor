@page "/admin/certifications"
@attribute [Authorize]
@rendermode InteractiveServer

@using Chronicle.Application.Common.Exceptions
@using Chronicle.Application.Common.Interfaces
@using Chronicle.Domain.Enums
@using Chronicle.Application.Features.Certifications.Commands.DeleteCertification
@using Chronicle.Application.Features.Certifications.Commands.SaveCertification
@using Chronicle.Application.Features.Certifications.Queries.GetCertificationsForAdmin
@using Chronicle.Portfolio.Server.Components.Shared
@using MediatR
@inject ISender Sender
@inject ICredentialLinkReader LinkReader

<PageTitle>Certifications - Chronicle admin</PageTitle>

<div class="page-head">
    <div>
        <h1>Certifications</h1>
        <p class="lede">
            Credentials, and what each one attests to. The skills you name here are what
            link a certificate to the skills page.
        </p>
    </div>
    <button type="button" class="button-primary" @onclick="StartNew">New certification</button>
</div>

<SaveResult Errors="errors" Message="@message" />

@if (editing is not null)
{
    <EditForm Model="editing" OnValidSubmit="SaveAsync" FormName="certification-editor">
        <fieldset class="field-group">
            <legend>@(editing.Id is null ? "New certification" : "Edit certification")</legend>

            <div class="field-row">
                <div class="field">
                    <label for="name">Name</label>
                    <InputText id="name" @bind-Value="editing.Name" />
                </div>

                <div class="field">
                    <label for="issuer">Issuer</label>
                    <InputText id="issuer" @bind-Value="editing.Issuer" />
                </div>

                <div class="field">
                    <label for="kind">Kind</label>
                    <InputSelect id="kind" @bind-Value="editing.Kind">
                        <option value="@CredentialKind.Certification">Certification</option>
                        <option value="@CredentialKind.AppliedSkill">Applied Skill</option>
                        <option value="@CredentialKind.Badge">Badge</option>
                        <option value="@CredentialKind.Training">Training</option>
                    </InputSelect>
                    <p class="field-help">
                        Certifications and Applied Skills reach the résumé; badges and
                        training do not. An invigilated exam and a module you clicked
                        through should not carry the same weight.
                    </p>
                </div>

                <div class="field">
                    <label for="issued">Issued</label>
                    <InputDate id="issued" @bind-Value="editing.IssueDate" />
                </div>

                <div class="field">
                    <label for="expires">Expires <span class="optional">optional</span></label>
                    <InputDate id="expires" @bind-Value="editing.ExpiryDate" />
                    <p class="field-help">
                        Leave blank for credentials that do not lapse. Set it and the site
                        marks it expired on the day rather than passing it off as current.
                    </p>
                </div>

                <div class="field">
                    <label for="order">Order</label>
                    <InputNumber id="order" @bind-Value="editing.SortOrder" />
                </div>
            </div>

            <div class="field">
                <label for="credential">Credential URL <span class="optional">optional</span></label>
                <div class="field-with-action">
                    <InputText id="credential" @bind-Value="editing.CredentialUrl" />
                    <button type="button" class="button-quiet" disabled="@reading" @onclick="ReadLinkAsync">
                        @(reading ? "Reading…" : "Read from link")
                    </button>
                </div>
                <p class="field-help">
                    Where someone can verify it. Full https address. A credential nobody can
                    check is worth less than one they can.
                </p>
                <p class="field-help">
                    <strong>Read from link</strong> fetches the page's own title and badge
                    image and fills the two fields below. It works for a Microsoft Learn
                    share URL — both the <code>/api/credentials/share/</code> and
                    <code>/api/achievements/share/</code> kinds — and for Credly. Other hosts
                    are refused on purpose, because this fetches whatever address is typed.
                </p>
                @if (linkNote is not null)
                {
                    <p class="field-help"><strong>@linkNote</strong></p>
                }
            </div>

            <div class="field">
                <label for="logo">Logo URL <span class="optional">optional</span></label>
                <InputText id="logo" @bind-Value="editing.LogoUrl" />
                @if (!string.IsNullOrWhiteSpace(editing.LogoUrl))
                {
                    <img src="@editing.LogoUrl" alt="" class="badge-preview" />
                }
            </div>

            <div class="field">
                <label for="skills">Skills it attests to</label>
                <InputText id="skills" @bind-Value="editing.Skills" />
                <p class="field-help">
                    Comma separated, and each must already exist on the Skills page.
                    AZ-204 might name both "Azure" and "C#".
                </p>
            </div>

            <div class="form-actions">
                <button type="submit" class="button-primary" disabled="@saving">
                    @(saving ? "Saving…" : "Save")
                </button>
                <button type="button" class="button-quiet" @onclick="Clear">Cancel</button>
            </div>
        </fieldset>
    </EditForm>
}

@if (rows is null)
{
    <p class="muted">Loading...</p>
}
else if (rows.Count == 0)
{
    <p class="muted">No certifications yet.</p>
}
else
{
    <table class="admin-table">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Issuer</th>
                <th scope="col">Issued</th>
                <th scope="col">Attests to</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in rows)
            {
                <tr>
                    <th scope="row">
                        @row.Name
                        @if (row.CredentialUrl is { } url)
                        {
                            <a class="row-sub" href="@url" target="_blank" rel="noreferrer">Verify</a>
                        }
                    </th>
                    <td class="row-sub">@row.Issuer</td>
                    <td class="row-sub">@row.IssueDate.ToString("MMM yyyy")</td>
                    <td class="row-sub">@(row.Skills.Count == 0 ? "—" : string.Join(", ", row.Skills))</td>
                    <td class="row-actions">
                        <button type="button" class="button-quiet" @onclick="() => StartEdit(row)">Edit</button>
                        @if (confirming == row.Id)
                        {
                            <button type="button" class="button-danger" @onclick="() => DeleteAsync(row.Id)">
                                Really delete
                            </button>
                            <button type="button" class="button-quiet" @onclick="() => confirming = null">Cancel</button>
                        }
                        else
                        {
                            <button type="button" class="button-quiet" @onclick="() => confirming = row.Id">Delete</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<AdminCertificationRow>? rows;
    private Form? editing;
    private Guid? confirming;
    private bool saving;
    private bool reading;
    private string? linkNote;
    private IDictionary<string, string[]>? errors;
    private string? message;

    private sealed class Form
    {
        public Guid? Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Issuer { get; set; } = string.Empty;
        public CredentialKind Kind { get; set; } = CredentialKind.Certification;
        public DateTime IssueDate { get; set; } = DateTime.Today;
        public DateTime? ExpiryDate { get; set; }
        public string? CredentialUrl { get; set; }
        public string? LogoUrl { get; set; }
        public int SortOrder { get; set; }
        public string Skills { get; set; } = string.Empty;
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>
    /// Fills the name and badge image from the credential link's own Open Graph tags.
    /// </summary>
    /// <remarks>
    /// Resolved here, at edit time, and stored — never fetched while a page renders. That
    /// keeps the public site working when Microsoft is unreachable, keeps an outbound
    /// request behind authentication, and means the badge survives the issuer changing
    /// anything later.
    /// <para>
    /// The name is only filled when the field is blank. Overwriting something already typed
    /// would be the wrong kind of helpful.
    /// </para>
    /// </remarks>
    private async Task ReadLinkAsync()
    {
        if (editing is null || string.IsNullOrWhiteSpace(editing.CredentialUrl))
        {
            linkNote = "Paste the share URL first.";
            return;
        }

        reading = true;
        linkNote = null;

        try
        {
            var link = await LinkReader.ReadAsync(editing.CredentialUrl);

            if (link is null)
            {
                linkNote = "Nothing readable there. Check the address, and note that only "
                    + "known credential issuers are fetched.";
                return;
            }

            if (string.IsNullOrWhiteSpace(editing.Name) && link.Title is { Length: > 0 })
            {
                editing.Name = link.Title;
            }

            if (link.ImageUrl is { Length: > 0 })
            {
                editing.LogoUrl = link.ImageUrl;
            }

            linkNote = link.Title is { Length: > 0 } ? $"Read: {link.Title}" : "Read the badge image.";
        }
        finally
        {
            reading = false;
        }
    }

    private async Task LoadAsync() => rows = await Sender.Send(new GetCertificationsForAdminQuery());

    private void StartNew()
    {
        Clear();
        editing = new Form
        {
            SortOrder = rows is { Count: > 0 } ? rows.Max(r => r.SortOrder) + 1 : 0
        };
    }

    private void StartEdit(AdminCertificationRow row)
    {
        Clear();
        editing = new Form
        {
            Id = row.Id,
            Name = row.Name,
            Issuer = row.Issuer,
            IssueDate = row.IssueDate.ToDateTime(TimeOnly.MinValue),
            CredentialUrl = row.CredentialUrl,
            LogoUrl = row.LogoUrl,
            Kind = row.Kind,
            ExpiryDate = row.ExpiryDate?.ToDateTime(TimeOnly.MinValue),
            SortOrder = row.SortOrder,
            Skills = string.Join(", ", row.Skills)
        };
    }

    private void Clear()
    {
        editing = null;
        confirming = null;
        errors = null;
        message = null;
    }

    private async Task SaveAsync()
    {
        if (editing is null) return;

        saving = true;
        errors = null;
        message = null;

        try
        {
            await Sender.Send(new SaveCertificationCommand(
                editing.Id,
                editing.Name,
                editing.Issuer,
                editing.Kind,
                DateOnly.FromDateTime(editing.IssueDate),
                editing.ExpiryDate is { } expiry ? DateOnly.FromDateTime(expiry) : null,
                editing.CredentialUrl,
                editing.LogoUrl,
                editing.SortOrder,
                [.. editing.Skills.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)]));

            message = "Saved.";
            editing = null;
            await LoadAsync();
        }
        catch (ValidationException ex)
        {
            errors = ex.Errors;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        await Sender.Send(new DeleteCertificationCommand(id));
        confirming = null;
        await LoadAsync();
    }
}

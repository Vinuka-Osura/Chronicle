@page "/admin/skills"
@attribute [Authorize]
@rendermode InteractiveServer

@using Chronicle.Application.Common.Exceptions
@using Chronicle.Application.Features.Skills.Commands.DeleteSkill
@using Chronicle.Application.Features.Skills.Commands.SaveSkill
@using Chronicle.Application.Features.Skills.Queries.GetSkillsForAdmin
@using Chronicle.Domain.Enums
@using Chronicle.Portfolio.Server.Components.Shared
@using MediatR
@inject ISender Sender

@*
    List and editor on one page, unlike Projects and Articles.

    Those carry long Markdown bodies that need the width of a whole screen; a skill is
    five short fields, and making the operator navigate away and back to change a number
    would be worse. The pattern is shared by every screen in this folder.
*@

<PageTitle>Skills - Chronicle admin</PageTitle>

<div class="page-head">
    <div>
        <h1>Skills</h1>
        <p class="lede">
            The vocabulary everything else draws on. A project or role can only list a
            skill that exists here, which is what stops a typo becoming a second entry
            with nothing behind it.
        </p>
    </div>
    <button type="button" class="button-primary" @onclick="StartNew">New skill</button>
</div>

<SaveResult Errors="errors" Message="@message" />

@if (editing is not null)
{
    <EditForm Model="editing" OnValidSubmit="SaveAsync" FormName="skill-editor">
        <fieldset class="field-group">
            <legend>@(editing.Id is null ? "New skill" : "Edit skill")</legend>

            <div class="field-row">
                <div class="field">
                    <label for="name">Name</label>
                    <InputText id="name" @bind-Value="editing.Name" />
                    <p class="field-help">Must match exactly what projects and roles list.</p>
                </div>

                <div class="field">
                    <label for="category">Category</label>
                    <InputSelect id="category" @bind-Value="editing.Category">
                        @foreach (var category in Enum.GetValues<SkillCategory>())
                        {
                            <option value="@category">@category</option>
                        }
                    </InputSelect>
                </div>

                <div class="field">
                    <label for="years">Years</label>
                    <InputNumber id="years" step="0.5" @bind-Value="editing.YearsExperience" />
                </div>

                <div class="field">
                    <label for="level">Level</label>
                    <InputSelect id="level" @bind-Value="editing.Proficiency">
                        @foreach (var level in Enum.GetValues<ProficiencyLevel>())
                        {
                            <option value="@level">@level</option>
                        }
                    </InputSelect>
                    <p class="field-help">Be honest — an inflated level is a trap you set for yourself.</p>
                </div>

                <div class="field">
                    <label for="order">Order</label>
                    <InputNumber id="order" @bind-Value="editing.SortOrder" />
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="button-primary" disabled="@saving">
                    @(saving ? "Saving…" : "Save")
                </button>
                <button type="button" class="button-quiet" @onclick="Cancel">Cancel</button>
            </div>
        </fieldset>
    </EditForm>
}

@if (rows is null)
{
    <p class="muted">Loading...</p>
}
else if (rows.Count == 0)
{
    <p class="muted">No skills yet. Add the first one before writing up a project.</p>
}
else
{
    <table class="admin-table">
        <thead>
            <tr>
                <th scope="col">Skill</th>
                <th scope="col">Category</th>
                <th scope="col">Years</th>
                <th scope="col">Level</th>
                <th scope="col">Used by</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in rows)
            {
                <tr>
                    <th scope="row">@row.Name</th>
                    <td class="row-sub">@row.Category</td>
                    <td class="row-sub">@row.YearsExperience.ToString("0.#")</td>
                    <td class="row-sub">@row.Proficiency</td>
                    <td class="row-sub">
                        @(row.UsageCount == 0 ? "—" : $"{row.UsageCount} item(s)")
                    </td>
                    <td class="row-actions">
                        <button type="button" class="button-quiet" @onclick="() => StartEdit(row)">Edit</button>
                        @if (confirming == row.Id)
                        {
                            <button type="button" class="button-danger" @onclick="() => DeleteAsync(row.Id)">
                                Really delete
                            </button>
                            <button type="button" class="button-quiet" @onclick="() => confirming = null">
                                Cancel
                            </button>
                        }
                        else
                        {
                            <button type="button" class="button-quiet" @onclick="() => confirming = row.Id">
                                Delete
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<AdminSkillRow>? rows;
    private Form? editing;
    private Guid? confirming;
    private bool saving;
    private IDictionary<string, string[]>? errors;
    private string? message;

    private sealed class Form
    {
        public Guid? Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public SkillCategory Category { get; set; } = SkillCategory.Backend;
        public decimal YearsExperience { get; set; }
        public ProficiencyLevel Proficiency { get; set; } = ProficiencyLevel.Working;
        public int SortOrder { get; set; }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => rows = await Sender.Send(new GetSkillsForAdminQuery());

    private void StartNew()
    {
        Clear();
        editing = new Form
        {
            // Appended within its category, so adding one never reorders what is there.
            SortOrder = rows is { Count: > 0 } ? rows.Max(r => r.SortOrder) + 1 : 0
        };
    }

    private void StartEdit(AdminSkillRow row)
    {
        Clear();
        editing = new Form
        {
            Id = row.Id,
            Name = row.Name,
            Category = row.Category,
            YearsExperience = row.YearsExperience,
            Proficiency = row.Proficiency,
            SortOrder = row.SortOrder
        };
    }

    private void Cancel() => Clear();

    private void Clear()
    {
        editing = null;
        confirming = null;
        errors = null;
        message = null;
    }

    private async Task SaveAsync()
    {
        if (editing is null) return;

        saving = true;
        errors = null;
        message = null;

        try
        {
            await Sender.Send(new SaveSkillCommand(
                editing.Id,
                editing.Name,
                editing.Category,
                editing.YearsExperience,
                editing.Proficiency,
                editing.SortOrder));

            message = "Saved.";
            editing = null;
            await LoadAsync();
        }
        catch (ValidationException ex)
        {
            errors = ex.Errors;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        errors = null;
        message = null;

        try
        {
            await Sender.Send(new DeleteSkillCommand(id));
            await LoadAsync();
        }
        catch (ValidationException ex)
        {
            // Refused because something still uses it. The message names what.
            errors = ex.Errors;
        }
        finally
        {
            confirming = null;
        }
    }
}

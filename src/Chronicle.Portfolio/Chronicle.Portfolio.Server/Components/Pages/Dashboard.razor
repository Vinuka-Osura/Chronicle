@page "/admin"
@attribute [Authorize]
@rendermode InteractiveServer

@using Chronicle.Application.Common.Content
@using Chronicle.Application.Common.Interfaces
@using Chronicle.Application.Features.Media
@using Chronicle.Application.Features.Media.Queries.GetStorageUsage
@using MediatR
@using Microsoft.EntityFrameworkCore
@inject IChronicleDbContext Db
@inject ISender Sender

<PageTitle>Dashboard - Chronicle admin</PageTitle>

<h1>Dashboard</h1>
<p class="lede">
    Content here publishes to the public site immediately - saving evicts the matching
    output-cache tag rather than waiting out the TTL.
</p>

@if (counts is null)
{
    <p class="muted">Loading content counts...</p>
}
else
{
    <ul class="stat-grid">
        @foreach (var (label, value) in counts)
        {
            <li class="stat">
                <span class="stat-value">@value</span>
                <span class="stat-label">@label</span>
            </li>
        }
    </ul>
}

@*
    The storage gauge.

    This is the mitigation that made object storage acceptable under the zero-cost rule:
    the margin between what is used and what is free has to be visible here, not two
    clicks into someone else's dashboard. A safeguard nobody looks at is not a safeguard.

    The number is summed from the database rather than read from the bucket, because
    listing a bucket is a billable operation and we already recorded every size at upload.
*@
@if (storage is not null)
{
    <section class="storage">
        <div class="storage-head">
            <h2>Media storage</h2>
            <p class="row-sub">@storage.Provider · @storage.Location</p>
        </div>

        @if (storage.PercentUsed is { } percent)
        {
            <div class="storage-meter">
                @* Floored at a visible sliver: 0.01% of a 10 GB tier is zero pixels wide,
                   and a bar that renders as nothing looks broken rather than empty. *@
                <div class="storage-fill" style="width: @(Math.Max(percent, 0.4).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
            </div>
            <p class="storage-label">
                <strong>@ImageValidation.Describe(storage.UsedBytes)</strong>
                of @ImageValidation.Describe(storage.QuotaBytes!.Value)
                (@percent.ToString("0.##")%) across @storage.FileCount
                file@(storage.FileCount == 1 ? "" : "s").
            </p>
        }
        else
        {
            <p class="storage-label">
                <strong>@ImageValidation.Describe(storage.UsedBytes)</strong>
                across @storage.FileCount file@(storage.FileCount == 1 ? "" : "s").
            </p>
        }
    </section>
}

<section class="next-up">
    <h2>Everything here is editable</h2>
    <p>
        <a href="/admin/projects">Projects</a>, <a href="/admin/posts">articles</a>,
        <a href="/admin/experience">experience</a>, <a href="/admin/skills">skills</a>,
        <a href="/admin/certifications">certifications</a>,
        <a href="/admin/chronology">eras and milestones</a>,
        <a href="/admin/learning">learning</a>, <a href="/admin/roadmap">roadmap</a> and the
        <a href="/admin/status">status strip</a>. Nothing on the public site needs a
        deploy to change.
    </p>
    <p class="muted">
        Start with <a href="/admin/skills">Skills</a> — projects, roles and certifications
        can only name a skill that already exists, which is what keeps a typo from
        becoming a second entry with nothing behind it.
    </p>
</section>

@code {
    private List<(string Label, int Count)>? counts;
    private StorageUsageDto? storage;

    protected override async Task OnInitializedAsync()
    {
        storage = await Sender.Send(new GetStorageUsageQuery());

        counts =
        [
            ("Projects", await Db.Projects.CountAsync()),
            ("Experience", await Db.Experiences.CountAsync()),
            ("Posts", await Db.Posts.CountAsync()),
            ("Skills", await Db.Skills.CountAsync()),
            ("Learning", await Db.LearningItems.CountAsync()),
            ("Roadmap", await Db.RoadmapItems.CountAsync()),
            ("Certifications", await Db.Certifications.CountAsync()),
            ("Tags", await Db.Tags.CountAsync())
        ];
    }
}

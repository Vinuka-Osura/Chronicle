@*
    Sends an unauthenticated visitor to the login page, preserving where they were
    heading so they land there after signing in rather than back at the dashboard.
*@
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"admin/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}

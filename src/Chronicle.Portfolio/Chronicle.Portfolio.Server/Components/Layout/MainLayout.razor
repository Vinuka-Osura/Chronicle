@inherits LayoutComponentBase

<div class="admin-shell">
    <header class="admin-bar">
        <a class="admin-brand" href="/admin">
            <span class="admin-brand-mark">CHRONICLE</span>
            <span class="admin-brand-sub">content admin</span>
        </a>

        <nav class="admin-nav">
            <NavLink href="/admin" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="/admin/projects">Projects</NavLink>
            <NavLink href="/admin/posts">Articles</NavLink>
            <NavLink href="/admin/status">Status</NavLink>
            <a href="/scalar/v1" target="_blank" rel="noreferrer">API</a>
        </nav>

        <AuthorizeView>
            <Authorized>
                <form class="admin-signout" action="/admin/logout" method="post">
                    <AntiforgeryToken />
                    <span class="admin-user">@context.User.Identity?.Name</span>
                    <button type="submit">Sign out</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </header>

    <main class="admin-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#128473;</span>
</div>

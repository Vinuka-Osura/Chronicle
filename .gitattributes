# Normalise line endings so Windows dev and Linux CI agree.
* text=auto eol=lf

# Windows-only files keep CRLF
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.sln  text eol=crlf

# Binary — never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pdf  binary
*.zip  binary
*.snk  binary

# Generated — collapse in PR diffs
package-lock.json linguist-generated=true -diff
**/Migrations/*.Designer.cs linguist-generated=true -diff
**/lib/types.ts linguist-generated=true
